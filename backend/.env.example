# Aplicação
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Banco de dados (os mesmos valores são usados pelo docker-compose.yml)
# Use 127.0.0.1 (não localhost) para evitar conflito com um Postgres rodando no WSL.
POSTGRES_USER=ativeplay
POSTGRES_PASSWORD=ativeplay
POSTGRES_DB=ativeplay
POSTGRES_PORT=5432
DB_HOST=127.0.0.1

# Autenticação — gere segredos fortes em produção: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Chave AES-256 (base64, 32 bytes) para cifrar credenciais de integrações: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Armazenamento de arquivos enviados (documentos e anexos)
UPLOAD_DIR=./storage
UPLOAD_MAX_MB=20

# Rotinas agendadas (geração de ocorrências e varredura de SLA)
JOBS_ENABLED=true

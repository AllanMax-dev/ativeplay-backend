# Aplicação
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Banco de dados (os mesmos valores são usados pelo docker-compose.yml)
# Use 127.0.0.1 (não localhost) para evitar conflito com um Postgres rodando no WSL.
POSTGRES_USER=ativeplay
POSTGRES_PASSWORD=ativeplay
POSTGRES_DB=ativeplay
POSTGRES_PORT=5432
DB_HOST=127.0.0.1

# Autenticação — gere segredos fortes em produção: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Chave AES-256 (base64, 32 bytes) para cifrar credenciais de integrações: openssl rand -base64 32
# Gere uma chave NOVA por ambiente: openssl rand -base64 32
# Nunca reutilize a chave antiga. Configure estes valores antes de iniciar.
ENCRYPTION_ACTIVE_KEY_ID=
ENCRYPTION_ACTIVE_KEY=
# Somente leitura de cifras legadas; mantenha a chave atual durante a migração.
ENCRYPTION_KEY=
# JSON de IDs anteriores para chaves, apenas enquanto houver cifras dessas versões.
ENCRYPTION_PREVIOUS_KEYS={}

# Armazenamento de arquivos enviados (documentos e anexos)
UPLOAD_DIR=./storage
UPLOAD_MAX_MB=20

# S3 compatível (opcional; as chaves abaixo só são exigidas com STORAGE_TIPO=s3)
STORAGE_TIPO=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Rotinas agendadas (geração de ocorrências e varredura de SLA)
JOBS_ENABLED=true